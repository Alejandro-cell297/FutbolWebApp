// C:\DataFlex Projects\FutbolWebApp\AppSrc\SelectLiga.wo
// Lista de ligas
//

Use cWebView.pkg
Use cWebList.pkg
Use cWebMenuGroup.pkg
Use cWebMenuItem.pkg
Use cWebColumnButton.pkg
Use cWebColumn.pkg
Use ZoomLiga.wo

Use cligaDataDictionary.dd

Object oSelectLiga is a cWebView
    Set psCaption to "Lista de ligas"
    Set peWebViewStyle to wvsDrilldown
    Set peViewType to vtSelect
    Set piColumnCount to 12
    Set pbShowCaption to False
    Set piMaxWidth to 1024

    Object oliga_DD is a cligaDataDictionary
    End_Object 

    Set Main_DD to oliga_DD
    Set Server  to oliga_DD


    Object oList is a cWebList
        Set piColumnSpan to 0
        Set psCSSClass to "MobileList"
        Set pbServerOnRowClick to True
        Set pbFillHeight to True
        Set pbShowHeader to True
        Set piSortColumn to 0

        Object oLigaNombre is a cWebColumn
            Entry_Item liga.Nombre
            Set psCaption to "Nombre"
            Set piWidth to 1000
        End_Object 

        Object oLigaPais is a cWebColumn
            Entry_Item liga.Pais
            Set psCaption to "País"
            Set piWidth to 500
        End_Object 

        Object oDetailButton is a cWebColumnButton
            Set psCaption to "btn"
            Set piWidth to 45
            Set pbFixedWidth to True
            Set pbResizable to False
            Set piListRowSpan to 1
            Set psBtnCssClass to "WebButtonIcon WebIcon_Info"
            Set peAlign to alignRight

            // NAVEGACIÓN FROM MAIN (botón de detalle de cada fila): oSelectLiga -> oZoomLiga.
            // Las dos vistas usan la misma tabla principal (liga), por eso el tipo es nfFromMain.
            // Vista que invoca: oSelectLiga | Objeto que invoca: oDetailButton | Vista destino: oZoomLiga.
            // En OnGetNavigateForwardData pongo bReadOnly a True: el Zoom se abre en solo lectura.
            WebRegisterPath ntNavigateForward oZoomLiga

            Procedure OnClick
                Send NavigatePath
            End_Procedure

            Procedure OnGetNavigateForwardData tWebNavigateData ByRef NavigateData Handle hoToView
                Move True to NavigateData.bReadOnly
            End_Procedure

        End_Object 

        WebRegisterPath ntNavigateForward oZoomLiga

        // CLIC EN UNA FILA: el objeto que invoca es oList. Lo que hace depende de cómo llegué a esta lista:
        //  - nfUndefined (vengo del Dashboard) -> FROM MAIN: voy a oZoomLiga con el registro pulsado.
        //  - nfFromParent (vengo del padre, lista ya acotada) -> FROM MAIN: voy a oZoomLiga.
        //  - nfFromChild (vengo de la lupa de un Zoom hijo) -> elijo el padre y vuelvo con NavigateClose.
        //  - nfFromMain (vengo de un Zoom de la misma tabla) -> vuelvo con NavigateClose.
        Procedure OnRowClick String sRowId
            tWebNavigateData NavigateData
            Get GetNavigateData to NavigateData

            Case Begin
                Case (NavigateData.eNavigateType = nfFromParent)
                    Send NavigateForward of oZoomLiga Self
                    Case Break

                Case (NavigateData.eNavigateType = nfFromChild)
                    Send NavigateClose Self
                    Case Break

                Case (NavigateData.eNavigateType = nfFromMain)
                    Send NavigateClose Self
                    Case Break

                Case Else // must be nfUndefined
                    Send NavigateForward of oZoomLiga Self

            Case End
        End_Procedure

        Procedure OnGetNavigateForwardData tWebNavigateData ByRef NavigateData Handle hoToView
            Move True to NavigateData.bReadOnly
        End_Procedure

    End_Object 

    Object oActionGroup is a cWebMenuGroup

        Object oSearch is a cWebMenuItem
            Set psCSSClass to "WebPromptMenuItem"
            Set psCaption to "Buscar"

            Procedure OnClick
                Send Search of oList
            End_Procedure

        End_Object 

        Object oNewButton is a cWebMenuItem
            Set psCSSClass to "WebClearMenuItem"
            Set psCaption to "Nuevo"

            // NAVEGACIÓN FROM MAIN (botón Nuevo): oSelectLiga -> oZoomLiga.
            // Objeto que invoca: oNewButton. Pongo bNewRecord a True: el Zoom se abre vacío para crear uno nuevo.
            WebRegisterPath ntNavigateForward oZoomLiga

            Procedure OnClick
                Send NavigatePath
            End_Procedure

            Procedure OnGetNavigateForwardData tWebNavigateData ByRef NavigateData Handle hoToView
                Move True to NavigateData.bNewRecord
            End_Procedure

        End_Object 
    End_Object 

    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
        // Títulos: arriba "Lista de ligas" y en la miga de pan "Ligas"
        Send SetHeaderCaption "Lista de ligas"
        Send SetBreadcrumbCaption "Ligas"

        WebSet pbRender of oNewButton to True
        WebSet pbRender of oDetailButton to True

        Case Begin
            Case (NavigateData.eNavigateType = nfFromParent)
                // If from parent, this is a constrained drill down
                // If Row select does main-zoom we don't need this
                WebSet pbRender of oDetailButton to False
                Case Break

            Case (NavigateData.eNavigateType = nfFromChild)
                // If from child, this is a probably a parent lookup from a Zoom
                Case Break

            Case (NavigateData.eNavigateType = nfFromMain)
                // If from main, this is a probably a main-file lookup from a Zoom
                WebSet pbRender of oDetailButton to False
                Case Break

            Case Else // must be nfUndefined
                // This may be the start of a drilldown query or this may be used for some kind of custom query.
                // Desde el Dashboard (nfUndefined) dejamos visible el boton de detalle
                // para poder ir al Zoom con la fila o con el boton (From Main)

        Case End

    End_Procedure


End_Object
